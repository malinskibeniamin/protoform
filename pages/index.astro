---
// biome-ignore lint/correctness/noUnusedImports: Astro resolves this import in the template.
import data from "blume:data";
// biome-ignore lint/correctness/noUnusedImports: Astro resolves this import in the template.
import PageLayout from "blume/components/layout/PageLayout.astro";

export const prerender = true;

// biome-ignore lint/correctness/noUnusedVariables: Astro resolves this variable in the template.
const description =
  "Build accessible React Hook Form experiences directly from Protobuf descriptors, Protovalidate constraints, CEL rules, and Google AIP conventions.";
---

<PageLayout
  site={{ title: data.config.title, description }}
  logo={data.config.logo}
  favicon={data.config.favicon}
  appleIcon={data.config.appleIcon}
  banner={data.config.banner}
  analytics={data.config.analytics}
  navigation={data.navigation}
  page={{ title: "Protoform", description, route: "/" }}
  siteUrl={data.config.site}
  themeMode={data.config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={data.config.search.enabled}
  ui={data.ui}
>
  <div
    class="mx-auto flex min-h-[70dvh] max-w-3xl flex-col items-center justify-center gap-6 px-6 py-24 text-center"
  >
    <p class="font-medium text-primary text-sm">Protobuf-driven forms</p>
    <h1 class="text-balance font-semibold text-4xl text-foreground">
      Build complete forms from your API contract
    </h1>
    <p class="max-w-2xl text-balance text-lg text-muted-foreground">
      {description}
    </p>
    <a
      class="rounded-md bg-primary px-5 py-3 font-medium text-primary-foreground text-sm"
      href="/docs">Explore Protoform documentation</a
    >
  </div>
</PageLayout>
