{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/astro",
    "ultracite/biome/type-aware",
    "ultracite/biome/tanstack"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!!**/.blume",
      "!!**/.blume-verify",
      "!!**/dist",
      "!!**/build",
      "!!**/public/r",
      "!!**/routeTree.gen.ts",
      "!!**/*_pb.ts",
      "!!**/*_form.ts",
      "!!conformance/gen",
      "!!examples/gen",
      "!!registry/**/gen",
      "!!registry/**/__golden__",
      "!!registry/base-nova/protoform/lib/protobuf-v1-bridge"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      // Every installed Biome rule is listed explicitly. Enabled rules fail as errors;
      // incompatible or noisy rules remain visibly off instead of being hidden in presets.
      "a11y": {
        "noAccessKey": "error",
        "noAmbiguousAnchorText": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAriaUnsupportedElements": "error",
        "noAutofocus": "off",
        "noDistractingElements": "error",
        "noHeaderScope": "error",
        "noInteractiveElementToNoninteractiveRole": "error",
        "noLabelWithoutControl": "error",
        "noNoninteractiveElementInteractions": "error",
        "noNoninteractiveElementToInteractiveRole": "error",
        "noNoninteractiveTabindex": "error",
        "noPositiveTabindex": "error",
        "noRedundantAlt": "error",
        "noRedundantRoles": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useAriaActivedescendantWithTabindex": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useGenericFontNames": "error",
        "useHeadingContent": "error",
        "useHtmlLang": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "error",
        "useKeyWithMouseEvents": "error",
        "useMediaCaption": "error",
        "useSemanticElements": "error",
        "useValidAnchor": "error",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error",
        "useValidAutocomplete": "error",
        "useValidLang": "error"
      },
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noDivRegex": "error",
        "noEmptyTypeParameters": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        },
        "noExcessiveLinesPerFunction": "off",
        "noExcessiveNestedTestSuites": "error",
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noForEach": "error",
        "noImplicitCoercions": "off",
        "noImportantStyles": "off",
        "noRedundantDefaultExport": "error",
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUselessCatch": "error",
        "noUselessCatchBinding": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessReturn": "off",
        "noUselessStringConcat": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefined": "off",
        "noUselessUndefinedInitialization": "error",
        "noVoid": "error",
        "useArrayFind": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "off",
        "useMaxParams": "off",
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimpleNumberKeys": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noConstructorReturn": "error",
        "noDuplicateArgumentNames": "error",
        "noDuplicateAttributes": "error",
        "noDuplicateEnumValueNames": "error",
        "noDuplicateInputFieldNames": "error",
        "noDuplicateVariableNames": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalDirnameFilename": "error",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidDirectionInLinearGradient": "error",
        "noInvalidGridAreas": "error",
        "noInvalidPositionAtImportRule": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noMissingVarFunction": "error",
        "noNestedComponentDefinitions": "error",
        "noNextAsyncClientComponent": "error",
        "noNodejsModules": "off",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noPrivateImports": "error",
        "noProcessGlobal": "off",
        "noQwikUseVisibleTask": "error",
        "noReactPropAssignments": "error",
        "noRenderReturnValue": "error",
        "noRestrictedElements": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noSolidDestructuredProps": "off",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnknownFunction": "error",
        "noUnknownMediaFeatureName": "error",
        "noUnknownProperty": "error",
        "noUnknownPseudoClass": "error",
        "noUnknownPseudoElement": "error",
        "noUnknownTypeSelector": "error",
        "noUnknownUnit": "error",
        "noUnmatchableAnbSelector": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnresolvedImports": "off",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": {
          "fix": "safe",
          "level": "error"
        },
        "noUnusedInstantiation": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "noVoidElementsWithChildren": "error",
        "noVoidTypeReturn": "error",
        "noVueDataObjectDeclaration": "error",
        "noVueDuplicateKeys": "error",
        "noVueReservedKeys": "error",
        "noVueReservedProps": "error",
        "noVueSetupPropsReactivityLoss": "error",
        "noVueVIfWithVFor": "error",
        "useExhaustiveDependencies": "error",
        "useGraphqlNamedOperations": "error",
        "useHookAtTopLevel": "error",
        "useImageSize": "error",
        "useImportExtensions": "off",
        "useInlineScriptId": "error",
        "useIsNan": "error",
        "useJsonImportAttributes": "error",
        "useJsxKeyInIterable": "error",
        "useLoneAnonymousOperation": "error",
        "useParseIntRadix": "error",
        "useQwikClasslist": "error",
        "useQwikMethodUsage": "error",
        "useQwikValidLexicalScope": "off",
        "useSingleJsDocAsterisk": "error",
        "useUniqueElementIds": "off",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useVueVForKey": "error",
        "useVueValidTemplateRoot": "error",
        "useVueValidVBind": "error",
        "useVueValidVCloak": "error",
        "useVueValidVElse": "error",
        "useVueValidVElseIf": "error",
        "useVueValidVHtml": "error",
        "useVueValidVIf": "error",
        "useVueValidVOn": "error",
        "useVueValidVOnce": "error",
        "useVueValidVPre": "error",
        "useVueValidVText": "error",
        "useYield": "error"
      },
      "nursery": {
        "noBaseToString": "off",
        "noComponentHookFactories": "off",
        "noConditionalExpect": "off",
        "noDrizzleDeleteWithoutWhere": "off",
        "noDrizzleUpdateWithoutWhere": "off",
        "noDuplicateFieldDefinitionNames": "error",
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveSelectorClasses": "error",
        "noExtendNative": "error",
        "noFloatingPromises": "off",
        "noIdenticalTestTitle": "off",
        "noImpliedEval": "error",
        "noInlineStyles": "error",
        "noInvalidPropertyInitValue": "error",
        "noJsRestrictedProperties": "error",
        "noJsxLeakedDollar": "off",
        "noJsxNamespace": "off",
        "noLoopFunc": "error",
        "noMisleadingReturnType": "off",
        "noMisusedPromises": "off",
        "noNegationInEqualityCheck": "error",
        "noNonScalableViewport": "error",
        "noPlaywrightElementHandle": "off",
        "noPlaywrightEval": "off",
        "noPlaywrightForceOption": "off",
        "noPlaywrightMissingAwait": "off",
        "noPlaywrightNetworkidle": "off",
        "noPlaywrightPagePause": "off",
        "noPlaywrightUselessAwait": "off",
        "noPlaywrightWaitForNavigation": "off",
        "noPlaywrightWaitForSelector": "off",
        "noPlaywrightWaitForTimeout": "off",
        "noReactNativeDeepImports": "off",
        "noReactNativeLiteralColors": "off",
        "noReactNativeRawText": "off",
        "noReactStringRefs": "off",
        "noRestrictedDependencies": "error",
        "noSvelteLegacyConst": "off",
        "noSvelteUnnecessaryStateWrap": "off",
        "noTailwindArbitraryValue": "off",
        "noTopLevelLiterals": "error",
        "noUndeclaredClasses": "off",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafePlusOperands": "off",
        "noUnsafeTypeAssertion": "error",
        "noUntrustedLicenses": "off",
        "noUnusedClasses": "off",
        "noUselessTypeConversion": "off",
        "noVueImportCompilerMacros": "off",
        "noVueRefAsOperand": "off",
        "noVueVOnNumberValues": "off",
        "useArraySome": "error",
        "useAstroClientOnlyDirectiveValue": "off",
        "useAwaitThenable": "off",
        "useBaseline": "error",
        "useConsistentTestIt": "off",
        "useControlLabel": "error",
        "useDisposables": "off",
        "useDomNodeTextContent": "error",
        "useDomQuerySelector": "error",
        "useExhaustiveSwitchCases": "off",
        "useExpect": "off",
        "useExplicitReturnType": "error",
        "useExplicitType": "error",
        "useIframeSandbox": "error",
        "useImportsFirst": "error",
        "useIncludes": "off",
        "useMathMinMax": "error",
        "useNamedCaptureGroup": "error",
        "useNamedLayer": "error",
        "useNullishCoalescing": "off",
        "usePlaywrightValidDescribeCallback": "off",
        "useQwikLoaderLocation": "off",
        "useReactAsyncServerFunction": "off",
        "useReactCompiler": "off",
        "useReactFunctionComponentDefinition": "off",
        "useReactNativePlatformComponents": "off",
        "useReduceTypeParameter": "error",
        "useRegexpExec": "off",
        "useRegexpTest": "error",
        "useScopedStyles": "off",
        "useSortedClasses": {
          "fix": "safe",
          "level": "error",
          "options": {
            "attributes": ["className"],
            "functions": ["clsx", "cva", "tw", "twMerge", "cn", "twJoin", "tv"]
          }
        },
        "useStringStartsEndsWith": "off",
        "useSvelteRequireEachKey": "off",
        "useTailwindShorthandClasses": "off",
        "useTestHooksInOrder": "off",
        "useTestHooksOnTop": "off",
        "useThisInClassMethods": "error",
        "useUnicodeRegex": "error",
        "useVarsOnTop": "error",
        "useVueConsistentDefinePropsDeclaration": "off",
        "useVueNextTickPromise": "off",
        "useVueValidVFor": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noDynamicNamespaceImportAccess": "error",
        "noImgElement": "error",
        "noJsxPropsBind": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "off",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "error",
        "useGoogleFontPreconnect": "error",
        "useSolidForComponent": "off",
        "useTopLevelRegex": "error",
        "useVueVapor": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        "noSecrets": "off"
      },
      "style": {
        "noCommonJs": "off",
        "noContinue": "off",
        "noDefaultExport": "off",
        "noDescendingSpecificity": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noExcessiveClassesPerFile": "off",
        "noExcessiveLinesPerFile": "off",
        "noExportedImports": "error",
        "noHeadElement": "error",
        "noHexColors": "off",
        "noImplicitBoolean": "off",
        "noIncrementDecrement": "error",
        "noInferrableTypes": "error",
        "noJsxLiterals": "off",
        "noMagicNumbers": "off",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "off",
        "noRestrictedGlobals": "error",
        "noRestrictedImports": "error",
        "noRestrictedTypes": "error",
        "noRootType": "error",
        "noShoutyConstants": "error",
        "noSubstr": "error",
        "noTernary": "off",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noValueAtRule": "error",
        "noVueOptionsApi": "error",
        "noYodaExpression": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useBlockStatements": {
          "fix": "safe",
          "level": "error"
        },
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useComponentExportOnlyModules": "off",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentCurlyBraces": "off",
        "useConsistentEnumValueType": "error",
        "useConsistentGraphqlDescriptions": "error",
        "useConsistentMemberAccessibility": "error",
        "useConsistentMethodSignatures": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useDeprecatedReason": "error",
        "useDestructuring": "error",
        "useEnumInitializers": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "off",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useExportsLast": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGlobalThis": "off",
        "useGraphqlNamingConvention": "error",
        "useGroupedAccessorPairs": "error",
        "useImportType": "error",
        "useInputName": "error",
        "useLiteralEnumMembers": "error",
        "useLoneExecutableDefinition": "error",
        "useNamingConvention": "off",
        "useNodeAssertStrict": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useReadonlyClassProperties": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "off",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error",
        "useVueConsistentVBindStyle": "error",
        "useVueConsistentVOnStyle": "error",
        "useVueDefineMacrosOrder": "error",
        "useVueHyphenatedAttributes": "error",
        "useVueMultiWordComponentNames": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noApproximativeNumericConstant": "error",
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noBiomeFirstException": "error",
        "noBitwiseOperators": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConsole": "error",
        "noConstEnum": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDeprecatedImports": "error",
        "noDeprecatedMediaType": "error",
        "noDocumentCookie": "error",
        "noDocumentImportInPage": "error",
        "noDoubleEquals": "error",
        "noDuplicateAtImportRules": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateCustomProperties": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateFields": "error",
        "noDuplicateFontNames": "error",
        "noDuplicateGraphqlOperationName": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noDuplicateProperties": "error",
        "noDuplicateSelectorsKeyframeBlock": "error",
        "noDuplicateTestHooks": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptyBlock": "error",
        "noEmptyBlockStatements": "error",
        "noEmptyInterface": "error",
        "noEmptySource": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExportsInTest": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noFocusedTests": "error",
        "noForIn": "off",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noHeadImportInDocument": "error",
        "noImplicitAnyLet": "error",
        "noImportAssign": "error",
        "noImportCycles": "error",
        "noImportantInKeyframe": "error",
        "noIrregularWhitespace": "error",
        "noLabelVar": "error",
        "noLeakedRender": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noMisplacedAssertion": "error",
        "noMisrefactoredShorthandAssign": "error",
        "noNestedPromises": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noOctalEscape": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noQuickfixBiome": "error",
        "noReactForwardRef": "error",
        "noReactSpecificProps": "off",
        "noRedeclare": "error",
        "noRedundantUseStrict": "error",
        "noReturnAssign": "error",
        "noSelfCompare": "error",
        "noShadow": "error",
        "noShadowRestrictedNames": "error",
        "noShorthandPropertyOverrides": "error",
        "noSkippedTests": "error",
        "noSparseArray": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noTemplateCurlyInString": "error",
        "noThenProperty": "error",
        "noTsIgnore": "error",
        "noUnassignedVariables": "error",
        "noUndeclaredEnvVars": "off",
        "noUnknownAtRules": "error",
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noVueArrowFuncInWatch": "error",
        "noWith": "error",
        "useAdjacentOverloadSignatures": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useBiomeIgnoreFolder": "error",
        "useDefaultSwitchClauseLast": "error",
        "useDeprecatedDate": "off",
        "useErrorMessage": "error",
        "useGetterReturn": "error",
        "useGoogleFontDisplay": "error",
        "useGuardForIn": "error",
        "useIsArray": "error",
        "useIterableCallbackReturn": "error",
        "useNamespaceKeyword": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useRequiredScripts": "error",
        "useStaticResponseMethods": "error",
        "useStrictMode": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "nursery": {
            // These experimental rules either duplicate each other, require broad semantic
            // migrations, or produce framework/tooling false positives. Every other nursery
            // rule remains enabled as an error through the top-level group setting.
            "noConditionalExpect": "off",
            // Dynamic component geometry and theme previews require runtime values; deleting
            // their inline styles is an unsafe fix that breaks layout and visual state.
            "noInlineStyles": "off",
            "noReactNativeDeepImports": "off",
            "noReactNativeLiteralColors": "off",
            "noReactNativeRawText": "off",
            // Installable registry modules use host-defined Tailwind tokens and arbitrary
            // variants that cannot be resolved inside this repository.
            "noTailwindArbitraryValue": "off",
            "noUndeclaredClasses": "off",
            "noUnsafeTypeAssertion": "off",
            "noUnusedClasses": "off",
            "useBaseline": "off",
            "useConsistentTestIt": {
              "level": "error",
              "options": {
                "function": "test",
                "withinDescribe": "test"
              }
            },
            "useExplicitReturnType": "off",
            "useExplicitType": "off",
            "useNamedCaptureGroup": "off",
            // Empty strings, false flags, and zero values are meaningful form inputs; `||`
            // is intentional at the reported fallback and boolean-composition sites.
            "useNullishCoalescing": "off",
            "useReactNativePlatformComponents": "off",
            // Forward-ref and polymorphic public components intentionally use const definitions.
            "useReactFunctionComponentDefinition": "off",
            // Biome 2.5 cannot parse Tailwind v4 arbitrary variants used by shadcn components.
            "useTailwindShorthandClasses": "off",
            "useUnicodeRegex": "off",
            // Assertion helpers own expectations on behalf of table-driven tests.
            "useExpect": "off"
          }
        }
      }
    },
    {
      // Generated catalog modules expose Blume's static `client` marker before imports.
      "includes": ["registry/base-nova/protoform/demo/catalog/**"],
      "linter": {
        "rules": {
          "nursery": {
            "useImportsFirst": "off"
          }
        }
      }
    },
    {
      // React 19's `act` always returns a thenable at runtime, but its void overload hides that
      // contract from Biome's type-aware rule for async callbacks.
      "includes": [
        "registry/base-nova/protoform/hooks/use-proto-form-tanstack-v2/index.test.tsx",
        "registry/base-nova/protoform/hooks/use-proto-form-tanstack/index.test.tsx",
        "registry/base-nova/protoform/hooks/use-proto-form-v8/conformance.test.tsx",
        "registry/base-nova/protoform/hooks/use-proto-form/partial-edit-validation.test.tsx",
        "registry/base-nova/protoform/hooks/use-proto-form/use-proto-form.test.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useAwaitThenable": "off"
          }
        }
      }
    },
    {
      // Both reported conversions are guarded by `typeof value === "number"`; Biome loses that
      // narrowing across the recursive JSON-field renderer.
      "includes": [
        "registry/base-nova/protoform/components/json-field/index.tsx"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noBaseToString": "off"
          }
        }
      }
    },
    {
      // CEL expression identifiers are bigint values, which Math.min/Math.max cannot accept.
      "includes": [
        "registry/base-nova/protoform/components/auto-form/cel-runtime.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useMathMinMax": "off"
          }
        }
      }
    },
    {
      // ResizeObserver requires instance methods even though this no-op DOM mock has no state.
      "includes": ["rstest.shared.setup.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "useThisInClassMethods": "off"
          }
        }
      }
    },
    {
      // Biome does not honor React Compiler's explicit "use no memo" directives. These
      // components are verified by the fail-fast compiler itself, which skips their known
      // imperative ref, controlled-editor, and layout-measurement boundaries.
      "includes": [
        "registry/base-nova/protoform/components/auto-form/field-wrapper.tsx",
        "registry/base-nova/protoform/components/auto-form/fields/shared.tsx",
        "registry/base-nova/protoform/components/json-field/index.tsx",
        "registry/base-nova/protoform/components/popover/index.tsx",
        "registry/base-nova/protoform/components/toggle-group/index.tsx"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "useReactCompiler": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "*.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noDefaultExport": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // React Compiler stabilizes component-local functions without manual memoization.
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      // The controller contract intentionally uses TypeScript's bivariant callback pattern so
      // value-specific field adapters remain assignable without weakening values to any.
      "includes": ["registry/**/components/auto-form/core-types.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentMethodSignatures": "off"
          }
        }
      }
    },
    {
      // Keep runtime guards around React refs, browser APIs, and supported third-party package
      // versions even when the currently installed declarations model them as always present.
      "includes": [
        "registry/base-nova/protoform/components/auto-form/adapters/tanstack-v2.tsx",
        "registry/base-nova/protoform/components/auto-form/adapters/tanstack.tsx",
        "registry/base-nova/protoform/components/auto-form/auto-form-core.tsx",
        "registry/base-nova/protoform/components/auto-form/fields/slider.tsx",
        "registry/base-nova/protoform/components/auto-form/renderers/array.tsx",
        "registry/base-nova/protoform/components/combobox/index.tsx",
        "registry/base-nova/protoform/components/input-group/index.tsx",
        "registry/base-nova/protoform/components/json-field/index.tsx",
        "registry/base-nova/protoform/components/tabs/index.tsx",
        "registry/base-nova/protoform/components/tags/index.tsx",
        "registry/base-nova/protoform/components/toggle-group/index.tsx",
        "registry/base-nova/protoform/hooks/use-controllable-state/index.ts",
        "registry/base-nova/protoform/lib/input-utils/index.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      // Registry primitives preserve the ref-forwarding API expected by installed consumers.
      "includes": ["registry/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactForwardRef": "off"
          }
        }
      }
    },
    {
      // Registry entrypoints are the public install units consumed by shadcn-compatible clients.
      "includes": [
        "registry/**/index.ts",
        "registry/**/index.tsx",
        "registry/**/core-types.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // These modules are intentional public facades rather than accidental barrels.
      "includes": [
        "examples/server/service.ts",
        "lib/protobuf-provider/index.ts",
        "registry/**/components/auto-form/proto/schema.ts",
        "registry/**/components/auto-form/proto/conversion.ts",
        "registry/**/components/auto-form/schema.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      // Registry demo modules are discovered through their required default-export contract.
      "includes": ["registry/**/demo/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noRedundantDefaultExport": "off"
          }
        }
      }
    },
    {
      // Test-local regexes and assertion helpers are isolated to a single test process.
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      // Rstest supplies its test function globally; Playwright specs remain excluded so their
      // fixture-aware test API must always be imported from @playwright/test.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "javascript": {
        "globals": ["test"]
      }
    },
    {
      // Browser-mode Rstest does not expose globals at runtime.
      "includes": [
        "**/*.browser.test.ts",
        "**/*.browser.test.tsx",
        "**/__browser__/**"
      ],
      "javascript": {
        "globals": []
      }
    },
    {
      // These exhaustive parsers and interpreters encode branch-heavy external specifications.
      "includes": [
        "registry/**/components/auto-form/**",
        "registry/**/components/input/index.tsx",
        "registry/**/components/json-field/index.tsx",
        "registry/**/lib/protobuf-provider/**",
        "registry/**/demo/bookstore/library-service.ts",
        "registry/**/hooks/use-proto-form*/proto-resolver.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      // Recursive field renderers intentionally dispatch back into the renderer graph.
      "includes": ["registry/**/components/auto-form/renderers/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noImportCycles": "off"
          }
        }
      }
    },
    {
      // These workflows are intentionally sequential because each iteration mutates shared
      // browser or request state before the next one starts.
      "includes": [
        "e2e/docs-screenshots.spec.ts",
        "registry/**/lib/protobuf-provider/aip-client-workflow.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // React error boundaries still require a class component.
      "includes": ["registry/**/components/auto-form/auto-form-core.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useReactFunctionComponents": "off"
          }
        }
      }
    },
    {
      // The reusable label primitive is associated by consumers through htmlFor or nesting.
      "includes": ["registry/**/components/label/index.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      // Astro imports are referenced by the template compiler rather than the frontmatter AST.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUnusedImports": "off",
            "useJsxKeyInIterable": "off"
          },
          "style": {
            "useImportType": "off"
          },
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    },
    {
      // These controlled positional editors and composition slots intentionally preserve
      // index identity because their public values do not contain domain identifiers.
      "includes": [
        "registry/**/components/auto-form/renderers/index.tsx",
        "registry/**/components/json-field/index.tsx",
        "registry/**/components/key-value-field/index.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      // The input addon offers pointer focus as a convenience; the associated input remains
      // directly keyboard-focusable, so the decorative addon must not become another tab stop.
      "includes": ["registry/**/components/input-group/index.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      // Container blur is used only for bubbled field validation and does not make the
      // schema editor itself interactive.
      "includes": ["registry/**/components/json-field/index.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      // This composite trigger contains removable tag buttons, so using a native button would
      // create invalid nested interactive controls; Base UI supplies keyboard behavior.
      "includes": ["registry/**/components/multi-select/index.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      // Blume islands require PascalCase filenames and default exports.
      "includes": ["islands/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
