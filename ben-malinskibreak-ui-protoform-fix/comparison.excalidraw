{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"id": "title", "type": "text", "x": 30, "y": 20, "width": 1000, "height": 35.0, "text": "Native screenshot CI: isolate OS font baselines", "originalText": "Native screenshot CI: isolate OS font baselines", "fontSize": 28, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.25, "strokeColor": "#172554"}, {"id": "base", "type": "text", "x": 30, "y": 90, "width": 460, "height": 25.0, "text": "Before: a5333a2 \u2014 ambient locale / one Mac baseline", "originalText": "Before: a5333a2 \u2014 ambient locale / one Mac baseline", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.25, "strokeColor": "#172554"}, {"id": "base1", "type": "text", "x": 30, "y": 140, "width": 1000, "height": 25.0, "text": "macos-latest \u2192 native date control \u2192 screenshot", "originalText": "macos-latest \u2192 native date control \u2192 screenshot", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.25, "strokeColor": "#172554"}, {"id": "base2", "type": "text", "x": 30, "y": 190, "width": 1000, "height": 25.0, "text": "Locale or OS font drift \u2192 false regression", "originalText": "Locale or OS font drift \u2192 false regression", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.25, "strokeColor": "#172554"}, {"id": "head", "type": "text", "x": 30, "y": 290, "width": 1000, "height": 25.0, "text": "After: eb8c7c6 \u2014 explicit locale / versioned Mac baselines", "originalText": "After: eb8c7c6 \u2014 explicit locale / versioned Mac baselines", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.25, "strokeColor": "#172554"}, {"id": "head1", "type": "text", "x": 30, "y": 340, "width": 1000, "height": 25.0, "text": "macos-latest \u2192 en_GB + 24h \u2192 native date control", "originalText": "macos-latest \u