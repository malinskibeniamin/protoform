{
  "name": "protoform",
  "version": "1.0.0",
  "private": true,
  "description": "protoform - protovalidate-compatible shadcn forms",
  "type": "module",
  "scripts": {
    "aip:lint": "bun run scripts/check-api-linter.ts",
    "build": "bun run registry:build && blume build --strict && bun run scripts/finalize-docs-build.ts",
    "check": "biome check . --error-on-warnings",
    "check:boundaries": "bun run scripts/check-core-boundaries.ts",
    "ci:gate": "bun run registry:build && bun run registry:smoke && bun run registry:consumer-smoke && bun run check:boundaries && bun run test:conformance && bun run aip:lint && bun run readiness:gate && bun run test:unit && bun run test:integration && bun run docs:blume:translate:check && bun run build && bun run docs:blume:audit && bun run typecheck && bun run lint:no-suppressions && bun run lint && bun run doctor:strict",
    "demos:generate": "bun run scripts/generate-demo-catalog.ts",
    "dev": "blume dev --port 55011",
    "docs:blume:audit": "blume audit --fail-on info --skip url_style",
    "docs:blume:build": "blume build --strict && bun run scripts/finalize-docs-build.ts",
    "docs:blume:check": "bun run scripts/check-docs-types.ts",
    "docs:blume:dev": "blume dev --port 55011",
    "docs:blume:doctor": "blume doctor",
    "docs:blume:e2e": "blume build --strict --isolated && astro preview --root .blume-verify --host 127.0.0.1 --port 55013",
    "docs:blume:eval": "blume eval --agent codex --threshold 1 --timeout 45",
    "docs:blume:translate": "blume translate --codex",
    "docs:blume:translate:check": "blume translate --check",
    "docs:blume:validate": "blume validate",
    "doctor:strict": "react-doctor . --yes --scope full --blocking warning --no-respect-inline-disables --no-score --no-supply-chain",
    "e2e:screenshots": "bun run test:e2e",
    "examples:dev": "bun run --parallel examples:server dev",
    "examples:generate": "buf generate --template buf.gen.examples.yaml",
    "examples:server": "bun run examples/server/server.ts",
    "fix": "biome check . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write",
    "lint:no-suppressions": "bun run scripts/check-no-suppressions.ts",
    "migrate:zod": "bun run scripts/migrate-zod-to-protoform.ts",
    "proto:breaking": "bun run scripts/check-proto-breaking.ts",
    "proto:generate": "buf dep update && buf generate --template buf.gen.example.yaml && buf generate --template buf.gen.examples.yaml && buf generate --template buf.gen.conformance.yaml && buf generate --template buf.gen.form.yaml && buf generate --template buf.gen.bookstore-form.yaml && bun run demos:generate && bun run registry:build",
    "quality:gate": "bun run registry:build && bun run registry:smoke && bun run registry:consumer-smoke && bun run check:boundaries && bun run test:conformance && bun run aip:lint && bun run readiness:gate && bun run test:unit && bun run test:integration && bun run test:browser && bun run test:e2e && bun run docs:blume:translate:check && bun run build && bun run docs:blume:audit && bun run typecheck && bun run lint:no-suppressions && bun run lint && bun run doctor:strict",
    "readiness:gate": "bun run scripts/readiness-report.ts --require-profile-complete",
    "readiness:report": "bun run scripts/readiness-report.ts",
    "registry:build": "shadcn build",
    "registry:consumer-smoke": "bun run scripts/consumer-fixture-smoke.ts",
    "registry:smoke": "bun run scripts/smoke-registry.ts",
    "release:gate": "bun run quality:gate",
    "release:verify-tag": "bun run scripts/verify-release-tag.ts",
    "start": "blume preview --host 0.0.0.0 --port 8080",
    "test": "bun run test:unit && bun run test:integration",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:setup": "playwright install chromium",
    "test:browser:update": "vitest run --config vitest.browser.config.ts --update",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "test:ci": "bun run test:unit:ci && bun run test:integration:smoke",
    "test:conformance": "vitest run --config vitest.conformance.config.ts --reporter=verbose",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:integration:smoke": "vitest run --config vitest.integration.config.ts examples/catalog/capability-demo.test.tsx examples/form-libraries/form-libraries.test.tsx registry/base-nova/protoform/components/auto-form/__tests__/proto-forms.test.tsx --maxWorkers=1 --reporter=dot",
    "test:integration:watch": "vitest --config vitest.integration.config.ts --reporter=verbose",
    "test:unit": "vitest run --config vitest.unit.config.ts --reporter=verbose",
    "test:unit:ci": "vitest run --config vitest.unit.config.ts --maxWorkers=1 --reporter=dot",
    "test:unit:watch": "vitest --config vitest.unit.config.ts --reporter=verbose",
    "typecheck": "bun run typecheck:coverage && bun run typecheck:source && bun run typecheck:tests && bun run docs:blume:check",
    "typecheck:coverage": "bun run scripts/check-typescript-coverage.ts",
    "typecheck:source": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@buf/googleapis_googleapis.bufbuild_es": "^2.13.0-20260414192239-c17df5b2beca.1",
    "@bufbuild/cel": "^0.6.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-query": "^2.3.1",
    "@connectrpc/connect-web": "^2.1.2",
    "@connectrpc/validate": "^0.2.0",
    "@hookform/resolvers": "^5.7.1",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-form-v2": "npm:@tanstack/react-form@2.0.0-alpha.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "blume": "1.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "final-form": "^5.0.1",
    "formik": "^2.4.9",
    "lucide-react": "^1.29.0",
    "motion": "^13.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-final-form": "^7.0.1",
    "react-hook-form": "^7.84.0",
    "react-hook-form-v8": "npm:react-hook-form@8.0.0-beta.3",
    "react-simple-code-editor": "^0.14.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.9",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@bufbuild/protoplugin": "^2.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "astro": "7.2.2",
    "happy-dom": "20.11.2",
    "react-doctor": "0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "packageManager": "bun@1.3.14"
}
