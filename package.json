{
  "name": "protoform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "blume dev --port 55011",
    "build": "bun run registry:build && blume build --strict",
    "start": "blume preview --host 0.0.0.0 --port 8080",
    "docs:blume:dev": "blume dev --port 55011",
    "docs:blume:build": "blume build --strict",
    "docs:blume:audit": "blume audit --fail-on error",
    "docs:blume:check": "blume check --strict --isolated",
    "docs:blume:doctor": "blume doctor",
    "docs:blume:e2e": "blume build --strict --isolated && astro preview --root .blume-verify --host 127.0.0.1 --port 55013",
    "docs:blume:eval": "blume eval --agent codex --threshold 1 --timeout 45",
    "docs:blume:validate": "blume validate",
    "examples:dev": "bun run --parallel examples:server dev",
    "examples:generate": "buf generate --template buf.gen.examples.yaml",
    "demos:generate": "bun run scripts/generate-demo-catalog.ts",
    "examples:server": "bun run examples/server/server.ts",
    "registry:build": "shadcn build",
    "typecheck": "tsgo --noEmit && bun run docs:blume:check",
    "typecheck:source": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check": "biome check .",
    "fix": "biome check . --write",
    "migrate:zod": "bun run scripts/migrate-zod-to-protoform.ts",
    "registry:smoke": "bun run scripts/smoke-registry.ts",
    "registry:consumer-smoke": "bun run scripts/consumer-fixture-smoke.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:conformance": "vitest run --config vitest.conformance.config.ts --reporter=verbose",
    "readiness:report": "bun run scripts/readiness-report.ts",
    "readiness:gate": "bun run scripts/readiness-report.ts --require-release-ready",
    "test:unit": "vitest run --config vitest.unit.config.ts --reporter=verbose",
    "test:unit:ci": "vitest run --config vitest.unit.config.ts --maxWorkers=1 --reporter=dot",
    "test:unit:watch": "vitest --config vitest.unit.config.ts --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose",
    "test:integration:smoke": "vitest run --config vitest.integration.config.ts examples/catalog/capability-demo.test.tsx examples/form-libraries/form-libraries.test.tsx registry/base-nova/protoform/components/auto-form/__tests__/proto-forms.test.tsx --maxWorkers=1 --reporter=dot",
    "test:ci": "bun run test:unit:ci && bun run test:integration:smoke",
    "test:integration:watch": "vitest --config vitest.integration.config.ts --reporter=verbose",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
    "test:browser:setup": "playwright install chromium",
    "e2e:screenshots": "bun run test:e2e",
    "proto:generate": "buf dep update && buf generate --template buf.gen.example.yaml && buf generate --template buf.gen.examples.yaml && buf generate --template buf.gen.conformance.yaml && buf generate --template buf.gen.form.yaml && buf generate --template buf.gen.bookstore-form.yaml && bun run demos:generate && bun run registry:build",
    "proto:breaking": "bun run scripts/check-proto-breaking.ts",
    "check:boundaries": "bun run scripts/check-core-boundaries.ts",
    "ci:gate": "bun run registry:build && bun run registry:smoke && bun run registry:consumer-smoke && bun run check:boundaries && bun run test:conformance && bun run readiness:gate && bun run test:unit && bun run test:integration && bun run build && bun run docs:blume:audit && bun run typecheck && bun run lint",
    "quality:gate": "bun run registry:build && bun run registry:smoke && bun run registry:consumer-smoke && bun run check:boundaries && bun run test:conformance && bun run readiness:gate && bun run test:unit && bun run test:integration && bun run test:browser && bun run test:e2e && bun run build && bun run docs:blume:audit && bun run typecheck && bun run lint",
    "release:gate": "bun run quality:gate",
    "release:verify-tag": "bun run scripts/verify-release-tag.ts",
    "test:browser:update": "vitest run --config vitest.browser.config.ts --update"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@buf/googleapis_googleapis.bufbuild_es": "^2.13.0-20260414192239-c17df5b2beca.1",
    "@bufbuild/cel": "^0.6.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-fastify": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@connectrpc/connect-query": "^2.2.0",
    "@connectrpc/connect-web": "^2.1.2",
    "@connectrpc/validate": "^0.2.0",
    "@fastify/cors": "^11.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@orama/orama": "^3.1.18",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "blume": "1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.11.2",
    "final-form": "^5.0.1",
    "formik": "^2.4.9",
    "lucide-react": "^1.29.0",
    "motion": "^13.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-final-form": "^7.0.1",
    "react-hook-form": "^7.84.0",
    "react-simple-code-editor": "^0.14.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.3",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@bufbuild/protoplugin": "^2.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.43",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "happy-dom": "20.10.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "^7.9.4",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "description": "protoform - protovalidate-compatible shadcn forms",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "overrides": {
    "@ai-sdk/gateway": "3.0.160",
    "@ai-sdk/provider-utils": "4.0.41",
    "@babel/core": "7.29.7",
    "@hono/node-server": "2.0.12",
    "@isaacs/brace-expansion": "5.0.1",
    "ai": "6.0.238",
    "astro": "7.1.6",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "cookie": "2.0.1",
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "hono": "4.12.33",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "playwright-core": "1.62.1",
    "qs": "6.15.3",
    "tar": "7.5.22",
    "undici": "8.9.0",
    "ws": "8.21.1"
  }
}
