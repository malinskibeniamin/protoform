---
import type { ComponentProps } from 'astro/types';
import RootLayout from 'blume/components/layout/RootLayout.astro';

interface Props extends ComponentProps<typeof RootLayout> {}

const sidebar = Astro.props.navigation.sidebar.map((item) => {
  if (item.kind !== 'group' || item.display !== 'group') {
    return item;
  }
  const { route, ...group } = item;
  return group.children.some((child) => child.kind === 'page' && child.route === route) ? group : item;
});
---

<RootLayout
  {...Astro.props}
  localeSwitch={Astro.props.localeSwitch?.filter((locale) => locale.current || !locale.untranslated)}
  navigation={{ ...Astro.props.navigation, sidebar }}
>
  <slot />
</RootLayout>
