{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "jsdoc", "node", "promise", "vitest"],
  "options": {
    "denyWarnings": true,
    "maxWarnings": 0,
    "typeAware": true,
    "typeCheck": true,
    "respectEslintDisableDirectives": false,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/gen/**",
    "**/*_pb.ts",
    "**/*_form.ts",
    "**/__golden__/**",
    "public/r/**",
    "registry/base-nova/protoform/lib/protobuf-v1-bridge/**"
  ],
  "rules": {
    // Reviewed: enforce as an error, including nursery checks.
    "accessor-pairs": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "array-callback-return": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "arrow-body-style": ["error", "as-needed"],
    // Reviewed: enforce as an error, including nursery checks.
    "block-scoped-var": "error",
    // Reviewed capitalized-comments: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "capitalized-comments": "off",
    // Reviewed class-methods-use-this: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "class-methods-use-this": "off",
    // Reviewed complexity: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "complexity": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "constructor-super": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "curly": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "default-case": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "default-case-last": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "default-param-last": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "eqeqeq": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "for-direction": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "func-name-matching": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "func-names": "error",
    // Reviewed func-style: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "func-style": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "getter-return": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "grouped-accessor-pairs": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "guard-for-in": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "id-denylist": "error",
    // Reviewed id-length: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "id-length": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "id-match": "error",
    // Reviewed init-declarations: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "init-declarations": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "logical-assignment-operators": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "max-classes-per-file": "error",
    // Reviewed max-depth: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "max-depth": "off",
    // Reviewed max-lines: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "max-lines": "off",
    // Reviewed max-lines-per-function: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "max-lines-per-function": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "max-nested-callbacks": "error",
    // Reviewed max-params: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "max-params": "off",
    // Reviewed max-statements: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "max-statements": "off",
    // Reviewed new-cap: Biome/Ultracite owns this convention or rejects the opposite construct; do not add a competing style restriction.
    "new-cap": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "no-alert": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "no-array-constructor": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "no-async-promise-executor": "error",
    // Biome owns this check and reviewed sequential browser/RPC workflows; parallelizing shared state is incorrect.
    "no-await-in-loop": "off",
    // Reviewed: enforce as an error, including nursery checks.
    "no-bitwise": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "no-caller": "error",
    // Reviewed: enforce as an error, including nursery checks.
    "no-case-declarations": "error",
    // Reviewed: enforce as an error, including nursery checks.
