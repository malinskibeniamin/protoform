{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "node_modules/**",
    ".context/**",
    ".blume/**",
    ".blume-verify/**",
    "dist/**",
    "public/r/**",
    ".tmp/**"
  ]
}
