# syntax=docker/dockerfile:1

FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS build
WORKDIR /app

COPY . .
RUN bun install --frozen-lockfile
RUN bun run registry:build
RUN bun run docs:blume:build
RUN bun run build:server

FROM oven/bun:1.3.14-alpine@sha256:5acc90a93e91ff07bf72aa90a7c9f0fa189765aec90b47bdbf2152d2196383c0 AS runtime-dependencies
WORKDIR /app

COPY package.json bun.lock .npmrc ./
COPY patches ./patches
RUN bun install --frozen-lockfile --production

FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS runtime
ENV HOST=0.0.0.0
ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app

LABEL org.opencontainers.image.description="Protoform documentation, source registry, and bounded demo API"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.source="https://github.com/malinskibeniamin/protoform"

COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=runtime-dependencies --chown=node:node /app/node_modules ./node_modules

USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "const base = 'http://127.0.0.1:' + (process.env.PORT || '8080'); Promise.all(['/api/health', '/docs'].map((path) => fetch(base + path))).then((responses) => { if (responses.some((response) => !response.ok)) process.exit(1); process.exit(0) }).catch(() => process.exit(1))"

CMD ["node", "./dist/production-server.mjs"]
